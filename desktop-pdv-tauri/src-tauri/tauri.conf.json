{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThorPDV Tauri Prototype",
  "version": "0.1.0",
  "identifier": "br.com.thorpdv.tauri.prototype",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "ThorPDV — Tauri 2 (protótipo)",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
